# =============================================================
# FRONTEND – Variables de entorno
# Copia este archivo como .env.local y completa los valores.
# NUNCA subas .env.local al repositorio.
# =============================================================

# URL base del backend (sin slash final)
# Desarrollo local:  http://localhost:3001
# QA / Producción:   https://api.tu-dominio.com
VITE_API_URL=http://localhost:3001

# ID del grupo de Supervisores en Azure AD / Microsoft Graph
VITE_SUPERVISION_GROUP_ID=

# ── Adobe Acrobat Sign ─────────────────────────────────────
ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=
ADOBE_REDIRECT_URI=
ADOBE_SIGN_BASE_URL=https://api.na4.adobesign.com
