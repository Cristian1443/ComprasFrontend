# =============================================================
# FRONTEND – Variables de entorno
# Copia este archivo como .env.local y completa los valores.
# NUNCA subas .env.local al repositorio.
# =============================================================

# URL base del backend (sin slash final)
# Desarrollo local:  http://localhost:3001
# QA / Producción:   https://api.tu-dominio.com
VITE_API_URL=http://localhost:3001

# ID del grupo de Supervisores en Azure AD / Microsoft Graph
VITE_SUPERVISION_GROUP_ID=tu-group-id-aqui

# ── Azure AD (MSAL / login) ─────────────────────────────────
# App Registration del portal (uno distinto por ambiente: dev/QA/producción)
VITE_AZURE_CLIENT_ID=tu-client-id-aqui
VITE_AZURE_TENANT_ID=tu-tenant-id-aqui

# Nota: Adobe Acrobat Sign se configura desde la BD (módulo Administrador ›
# Configuración de Firmas), no por variables de entorno del frontend.
